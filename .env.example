# API local de llama.cpp. El identificador se descubre con GET /v1/models.
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=auto
LLM_TIMEOUT=180
LLM_MAX_TOKENS=1000
LLM_TOOL_MODE=native
# Clave compartida solo para los usuarios ficticios del kit, en localhost.
MIRA_DEMO_PASSWORD=mira-demo
# No habilitar sin autenticación real, TLS y gestión de identidades.
MIRA_HOST=127.0.0.1
MIRA_PORT=8000
